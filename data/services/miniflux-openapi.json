      "EnclosureId": { "name": "enclosureId", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Enclosure ID" },
      "UserId": { "name": "userId", "in": "path", "required": true, "schema": { "oneOf": [ { "type": "integer" }, { "type": "string" } ] }, "description": "User ID (numeric) or username" },
      "ApiKeyId": { "name": "apiKeyId", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "API key ID" },
      "EntryQuery": {
        "name": "query",
        "in": "query",
        "description": "Filtering, ordering, and pagination parameters for entry listings.",
        "schema": { "type": "object" },
        "examples": {},
        "deprecated": true
      },
      "StatusParam": { "name": "status", "in": "query", "required": false, "description": "Filter by entry status. May be repeated for multiple values (e.g. status=read&status=unread).", "schema": { "oneOf": [ { "type": "string", "enum": ["read", "unread", "removed"] }, { "type": "array", "items": { "type": "string", "enum": ["read", "unread", "removed"] } } ] } },
      "OffsetParam": { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0 } },
      "LimitParam": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } },
      "OrderParam": { "name": "order", "in": "query", "required": false, "description": "Sort field for entries.", "schema": { "type": "string", "enum": ["id", "status", "published_at", "updated_at", "created_at"] } },
      "DirectionParam": { "name": "direction", "in": "query", "required": false, "schema": { "type": "string", "enum": ["asc", "desc"] } },
      "StarredParam": { "name": "starred", "in": "query", "required": false, "schema": { "type": "boolean" } },
      "SearchParam": { "name": "search", "in": "query", "required": false, "schema": { "type": "string" } },
      "AfterEntryIdParam": { "name": "after_entry_id", "in": "query", "required": false, "description": "Return entries with ID greater than this value (forward pagination).", "schema": { "type": "integer" } },
      "BeforeEntryIdParam": { "name": "before_entry_id", "in": "query", "required": false, "description": "Return entries with ID less than this value (backward pagination).", "schema": { "type": "integer" } },
      "AfterParam": { "name": "after", "in": "query", "required": false, "description": "Entries published after this Unix timestamp.", "schema": { "type": "integer", "format": "int64" } },
      "BeforeParam": { "name": "before", "in": "query", "required": false, "description": "Entries published before this Unix timestamp.", "schema": { "type": "integer", "format": "int64" } },
      "PublishedAfterParam": { "name": "published_after", "in": "query", "required": false, "schema": { "type": "integer", "format": "int64" } },
      "PublishedBeforeParam": { "name": "published_before", "in": "query", "required": false, "schema": { "type": "integer", "format": "int64" } },
      "CategoryIdParam": { "name": "category_id", "in": "query", "required": false, "description": "Filter entries by category. May be repeated for multiple categories.", "schema": { "oneOf": [ { "type": "integer" }, { "type": "array", "items": { "type": "integer" } } ] } },
      "FeedIdQueryParam": { "name": "feed_id", "in": "query", "required": false, "description": "Filter entries by feed. May be repeated for multiple feeds.", "schema": { "oneOf": [ { "type": "integer" }, { "type": "array", "items": { "type": "integer" } } ] } },
      "TagsParam": { "name": "tags", "in": "query", "required": false, "description": "Filter entries by tags. May be repeated for multiple tags.", "schema": { "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] } }
    },
