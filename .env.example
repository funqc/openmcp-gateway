# --- 服务端 ---
PORT=3001
# MCP HTTP 服务绑定地址
#   127.0.0.1 = 仅本机（默认，最安全）
#   0.0.0.0  = 监听所有网卡（内网/公网暴露时用，务必配 GATEWAY_API_KEY）
HOST=127.0.0.1

# --- 网关访问鉴权（/mcp 端点）---
# 静态 API Key。客户端通过 Authorization: Bearer <key> 或 X-API-Key: <key> 访问。
# 留空 = 不鉴权（仅适合 127.0.0.1 本机部署）。
# 公网/内网暴露时【必须】配置！生成一个: openssl rand -hex 32
GATEWAY_API_KEY=

# --- 存储 ---
DB_PATH=./data/registry.db

# --- 检索后端 ---
# 取值："bm25"（默认，零依赖） | "embedding"（本地 ONNX，需 @huggingface/transformers）
SEARCH_PROVIDER=bm25
# 仅 SEARCH_PROVIDER=embedding 时生效
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- 治理 ---
# 可选的策略文件路径（JSON）。缺省则用默认值。
POLICY_PATH=./data/policy.json
# 逗号分隔的、需从响应与审计日志中递归脱敏的字段名
REDACT_FIELDS=password,token,secret,apiKey,authorization,access_token,refresh_token

# --- 后端服务注册 ---
# 指向声明所有 NAS 服务的 YAML 配置文件（复制 data/services.example.yaml 改）。
# 文件不存在时网关仍可启动（无自动注册的服务），可后续编程式注册。
SERVICES_CONFIG=./data/services.yaml

# --- 按服务的认证（可选）---
# 凭据按服务 id 解析，永不返回给调用方。
# 格式：AUTH_<服务ID大写>_SCHEME / AUTH_<服务ID大写>_VALUE
# 例如：
#   AUTH_FILES_SCHEME=bearer
#   AUTH_FILES_VALUE=eyJhbGciOi...
#   AUTH_PHOTOS_SCHEME=apikey
#   AUTH_PHOTOS_VALUE=your-api-key
#   AUTH_PHOTOS_HEADER=X-API-Key        # apikey 时指定 header 名（默认 X-API-Key）
#
# 额外的 per-service 自定义 header（可选，JSON 对象）。
# 典型用途：Bangumi 要求每个请求带合规 User-Agent，否则封禁。
# 例如：
#   AUTH_BANGUMI_HEADERS={"User-Agent":"yourname/yourapp (https://github.com/yourname/yourapp)"}
# Bangumi UA 规范：需含开发者 ID + 应用名；分发类应用加版本号；开源项目加项目主页。
# 不要用 "database"、"Bangumi/1.0" 这类泛用 UA，会被禁。
